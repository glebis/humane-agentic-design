{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/glebis/humane-agentic-design/design-frameworks/adapter-contract-0.1.schema.json",
  "title": "Humane Design Frameworks conformance fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixtureVersion", "source", "manifest", "resources", "plan", "findings"],
  "properties": {
    "fixtureVersion": { "const": "0.1" },
    "source": { "$ref": "#/$defs/FixtureSource" },
    "manifest": { "$ref": "#/$defs/AdapterManifest" },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/FrameworkResource" }
    },
    "plan": { "$ref": "#/$defs/FitPlan" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/Finding" }
    }
  },
  "$defs": {
    "FixtureSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedAt", "evidence"],
      "properties": {
        "capturedAt": { "type": "string", "format": "date" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "note": { "type": "string" }
      }
    },
    "AdapterManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "preset",
        "profiles",
        "upstream",
        "projectRoot",
        "surfaces",
        "capabilities",
        "checks",
        "limitations"
      ],
      "properties": {
        "contractVersion": { "const": "0.1" },
        "preset": { "type": "string", "minLength": 1 },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["native-cli", "registry", "catalog-mcp", "token-toolchain"]
          }
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "projectRoot": { "type": "string", "minLength": 1 },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Surface" }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/OperationCapability" }
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/NativeCheck" }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "Surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "authority", "locator", "version", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["cli", "api", "registry", "mcp", "manifest", "files", "tokens", "docs"]
        },
        "authority": { "enum": ["native", "project", "remote"] },
        "locator": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["stable", "experimental", "unknown"] }
      }
    },
    "OperationCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "supported",
        "access",
        "network",
        "preview",
        "approval",
        "surfaceIds"
      ],
      "properties": {
        "operation": {
          "enum": ["probe", "catalog", "inspect", "plan", "preview", "apply", "validate"]
        },
        "supported": { "type": "boolean" },
        "access": { "enum": ["read", "write"] },
        "network": { "type": "boolean" },
        "preview": { "enum": ["supported", "not-supported", "not-applicable"] },
        "approval": { "enum": ["required", "not-required"] },
        "surfaceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "NativeCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "surfaceId", "mode", "locator"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "surfaceId": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["command", "tool", "schema", "project"] },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "FrameworkResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "nativeId",
        "surfaceId",
        "sourceLocator",
        "upstreamVersion",
        "dependencies",
        "constraints",
        "nativePayload",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["component", "pattern", "template", "token-set", "theme", "document", "check"]
        },
        "name": { "type": "string", "minLength": 1 },
        "nativeId": { "type": "string", "minLength": 1 },
        "surfaceId": { "type": "string", "minLength": 1 },
        "sourceLocator": { "type": "string", "minLength": 1 },
        "upstreamVersion": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "nativePayload": { "type": "object" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "evidence"],
          "properties": {
            "authority": { "enum": ["native", "project", "remote"] },
            "evidence": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "ImplementationBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "briefId",
        "jobRef",
        "evidenceRefs",
        "conceptRef",
        "prototypeRef",
        "acceptanceCriteria"
      ],
      "properties": {
        "briefId": { "type": "string", "minLength": 1 },
        "jobRef": { "type": ["string", "null"] },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "conceptRef": { "type": ["string", "null"] },
        "prototypeRef": { "type": ["string", "null"] },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "FitPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "id",
        "preset",
        "status",
        "traceability",
        "implementationBrief",
        "selectedResourceIds",
        "operations",
        "conflicts",
        "deviations",
        "validationCheckIds"
      ],
      "properties": {
        "contractVersion": { "const": "0.1" },
        "id": { "type": "string", "minLength": 1 },
        "preset": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ready", "blocked"] },
        "traceability": { "enum": ["available", "not-available"] },
        "implementationBrief": { "$ref": "#/$defs/ImplementationBrief" },
        "selectedResourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/PlannedOperation" }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Conflict" }
        },
        "deviations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "validationCheckIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "PlannedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "surfaceId", "kind", "target", "preview", "approval"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operation": { "const": "apply" },
        "surfaceId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["command", "file"] },
        "target": { "type": "string", "minLength": 1 },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "summary", "writes", "dependencies", "networkSources"],
          "properties": {
            "status": { "enum": ["exact", "unavailable"] },
            "summary": { "type": "string", "minLength": 1 },
            "writes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "dependencies": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "networkSources": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "approval": { "const": "required" }
      }
    },
    "Conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "statement", "decision"],
      "properties": {
        "severity": { "enum": ["blocking", "non-blocking"] },
        "statement": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 }
      }
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lane", "checkId", "status", "severity", "summary", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "lane": { "enum": ["framework", "humane"] },
        "checkId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "warn", "not-run", "not-supported"] },
        "severity": { "enum": ["blocking", "high", "medium", "low", "info"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locator", "observation"],
            "properties": {
              "locator": { "type": "string", "minLength": 1 },
              "observation": { "type": "string", "minLength": 1 }
            }
          }
        },
        "remediation": { "type": "string" }
      }
    }
  }
}
